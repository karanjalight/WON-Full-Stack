# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=worldolympiadsnetwork.org,www.worldolympiadsnetwork.org,127.0.0.1,localhost

# Database: True = SQLite (local dev), False = PostgreSQL (production)
USE_SQLITE=True

# Database Settings (PostgreSQL — ignored when USE_SQLITE=True)
DB_NAME=myproject
DB_USER=myprojectuser
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Paystack Configuration
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# Brand theme color (lime)
WON_BRAND_COLOR=#b9d533

# Public support contact
WON_SUPPORT_EMAIL=support@worldolympiads.org
WON_SUPPORT_PHONE=0738509200
WON_SUPPORT_PHONE_TEL=+254738509200

# Social (@won-olympiads — update if handles change)
WON_SOCIAL_INSTAGRAM=https://www.instagram.com/worldolympiadnetwork/
WON_SOCIAL_X=https://x.com/won_olympiads
WON_SOCIAL_LINKEDIN=https://www.linkedin.com/company/world-olympiad-network/
# WON_SOCIAL_FACEBOOK=
# WON_SOCIAL_YOUTUBE=

# Google Tag Manager — Admin → Container → Container ID (GTM-XXXXXXX)
# Configure GA4 (G-...) and other tags inside tagmanager.google.com
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# GOOGLE_TAG_MANAGER_DISABLED=True
