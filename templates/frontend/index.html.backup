{% load static %}
<!DOCTYPE html>
<html lang="en">
    <!--<< Header Area >>-->
     <head>
        <!-- ========== Meta Tags ========== -->
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="Paul Karanja">
        <meta name="description" content="WON — World Olympiad Network | Africa's gateway to global academic excellence. Discover Olympiads, apply with ease, and get preparation plus travel support.">
        <!-- ======== Page title ============ -->
        <title>WON — World Olympiad Network | Africa's Gateway to Global Academic Excellence</title>
        <!--<< Favicon >>-->
        <link rel="shortcut icon" href="{% static 'img/favicon.svg' %}">
        <!--<< Bootstrap min.css >>-->
        <link rel="stylesheet" href="{% static 'css/bootstrap.min.css' %}">
        <!--<< Font Awesome.css >>-->
        <link rel="stylesheet" href="{% static 'css/font-awesome.css' %}">
        <!--<< Animate.css >>-->
        <link rel="stylesheet" href="{% static 'css/animate.css' %}">
        <!--<< Magnific Popup.css >>-->
        <link rel="stylesheet" href="{% static 'css/magnific-popup.css' %}">
        <!--<< MeanMenu.css >>-->
        <link rel="stylesheet" href="{% static 'css/meanmenu.css' %}">
        <!--<< Odometer.css >>-->
        <link rel="stylesheet" href="{% static 'css/odometer.css' %}">
        <!--<< Swiper Bundle.css >>-->
        <link rel="stylesheet" href="{% static 'css/swiper-bundle.min.css' %}">
        <!--<< DatePicker.css >>-->
        <link rel="stylesheet" href="{% static 'css/datepickerboot.css' %}">
        <!--<< Nice Select.css >>-->
        <link rel="stylesheet" href="{% static 'css/nice-select.css' %}">
        <!--<< Main.css >>-->
        <link rel="stylesheet" href="{% static 'css/main.css' %}">
        <!--<< Style.css >>-->
        <link rel="stylesheet" href="{% static 'css/style.css' %}">
        <!--<< Custom Styles >>-->
        <style>
            /* Make Olympiads dropdown wider to show text in one line */
            .main-menu ul li .submenu {
                min-width: 400px !important;
                white-space: nowrap;
            }
            /* Use Bootstrap gutters for the destination grid */
            .tour-section .row {
                width: 100%;
                flex-wrap: wrap;
            }
            .tour-section .col-xl-3 {
                display: flex;
            }
            .tour-section .tour-box-items {
                display: flex;
                flex-direction: column;
                height: 95%;
                margin-bottom: 1.5rem;
                padding-bottom: 0; /* allow consistent bottom space via gap */
            }
            .tour-section .tour-box-items .content {
                display: flex;
                flex-direction: column;
            }
            .tour-section .tour-box-items .content h6 {
                margin: 0;
                padding-bottom: 10px;
                border-bottom: 1px dashed rgba(21, 20, 21, 0.21);
                margin-bottom: 12px;
            }
            .tour-section .tour-box-items .content ul.list {
                margin: 0;
                margin-top: auto;
                gap: 0.75rem;
            }
            .tour-section .tour-box-items .content ul.list li {
                margin-bottom: 0;
            }
        </style>
    </head>

    <body>

        <!-- Preloader Start -->
        <div id="preloader" class="preloader">
            <div class="animation-preloader">
                <div class="spinner">                
                </div>
                <div class="txt-loading">
                    <span data-text-preloader="W" class="letters-loading">W</span>
                    <span data-text-preloader="O" class="letters-loading">O</span>
                    <span data-text-preloader="N" class="letters-loading">N</span>
                </div>
                <p class="text-center">Loading</p>
            </div>
            <div class="loader">
                <div class="row">
                    <div class="col-3 loader-section section-left">
                        <div class="bg"></div>
                    </div>
                    <div class="col-3 loader-section section-left">
                        <div class="bg"></div>
                    </div>
                    <div class="col-3 loader-section section-right">
                        <div class="bg"></div>
                    </div>
                    <div class="col-3 loader-section section-right">
                        <div class="bg"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back To Top start -->
        <button id="back-top" class="back-to-top">
            <i class="fas fa-long-arrow-up"></i>
        </button>

        <!-- Offcanvas Area Start -->
        <div class="fix-area">
            <div class="offcanvas__info">
                <div class="offcanvas__wrapper">
                    <div class="offcanvas__content">
                        <div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
                        <div class="offcanvas__logo">
                            <a href="index.html" class="header-logo text-logo" style="font-size: 20px; font-weight: 700; color: #000;">WON — World Olympiad Network</a>
                        </div>
                            <div class="offcanvas__close">
                                <button>
                                <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <h3 class="offcanvas-title">Welcome to WON</h3>
                        <p>Discover Olympiads, apply with ease, and plan travel seamlessly.</p>
                        <div class="mobile-menu fix mb-3"></div>
                        <div class="offcanvas__contact">
                            <h3>Contact Us</h3>
                            <form action="#" id="contact-form" method="POST" class="contact-form-items">
                                <div class="row g-4">
                                    <div class="col-lg-12">
                                        <div class="form-clt">
                                            <input type="text" name="name" id="name33" placeholder="Name">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                    <div class="form-clt">
                                        <input type="email" name="email" id="email33" placeholder="Email Address">
                                    </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-clt">
                                            <textarea name="message" id="message2" placeholder="Enter message..."></textarea>
                                        </div>
                                    </div>
                                </div>
                            </form>
                            <div class="social-icon d-flex align-items-center">
                                <a href="https://instagram.com/worldolympiadnetwork"><i class="fab fa-instagram"></i></a>
                                <a href="https://twitter.com/won_global"><i class="fab fa-twitter"></i></a>
                                <a href="https://linkedin.com/company/world-olympiad-network"><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="offcanvas__overlay"></div> 

        {% include 'partials/navbar.html' %}
        
        <!-- Search Section Start -->
        <div class="header-search-bar d-flex align-items-center">
            <button class="search-close">×</button>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-12">
                        <div class="search-bar">
                            <div class="contact-form-box contact-search-form-box">
                                <form action="#">
                                    <input type="email" placeholder="Search here...">
                                    <button type="submit"><i class="far fa-search"></i></button>
                                </form>
                                <p>Type above and press Enter to search. Press Close to cancel.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Section Start -->
        <section class="hero-section hero-4">
            <div class="array-button">
                <button class="array-prev"><i class="far fa-long-arrow-left"></i></button>
                <button class="array-next"><i class="far fa-long-arrow-right"></i></button>
            </div>
            <div class="swiper hero-slider">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="hero-items">
                            <div class="plane-shape">
                                <img src="{% static 'img/hero/new/plane-2.png' %}" alt="img">
                            </div>
                            <div class="plane-shape-2">
                                <img src="{% static 'img/hero/new/plane-3.png' %}" alt="img">
                            </div>
                            <div class="hero-bg bg-cover" style="background-image: url('{% static 'img/index/study1.jpg' %}');"></div>
                            <div class="container">
                                <div class="row g-4">
                                    <div class="col-lg-12">
                                        <div class="hero-content"> 
                                            <h6 data-animation="fadeInUp" data-delay="1.3s">WON</h6>
                                            <h1 data-animation="fadeInUp" data-delay="1.5s">
                                                <span class="shape-text">World Olympiad</span> <br>  Network
                                               
                                            </h1>
                                            <p data-animation="fadeInUp" data-delay="1.7s">Welcome to Africa's gateway to global academic excellence.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="hero-items">
                            <div class="plane-shape">
                                <img src="{% static 'img/hero/new/plane-2.png' %}" alt="img">
                            </div>
                            <div class="plane-shape-2">
                                <img src="{% static 'img/hero/new/plane-3.png' %}" alt="img">
                            </div>
                            <div class="hero-bg bg-cover" style="background-image: url('{% static 'img/index/study2.jpg' %}');"></div>
                            <div class="container">
                                <div class="row g-4">
                                    <div class="col-lg-12">
                                        <div class="hero-content">
                                            <h6 data-animation="fadeInUp" data-delay="1.3s">WON</h6>
                                            <h1 data-animation="fadeInUp" data-delay="1.5s">
                                                <span class="shape-text">Your Child</span><span>is a global Champion</span> <br> 
                                               
                                            </h1>
                                            <p data-animation="fadeInUp" data-delay="1.7s">Explore global Olympiads, apply with ease, and access complete preparation and travel support.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="hero-items">
                            <div class="plane-shape">
                                <img src="{% static 'img/hero/new/plane-2.png' %}" alt="img">
                            </div>
                            <div class="plane-shape-2">
                                <img src="{% static 'img/hero/new/plane-3.png' %}" alt="img">
                            </div>
                            <div class="hero-bg bg-cover" style="background-image: url('{% static 'img/index/study6.jpg' %}');"></div>
                            <div class="container">
                                <div class="row g-4">
                                    <div class="col-lg-12">
                                        <div class="hero-content">
                                            <h6 data-animation="fadeInUp" data-delay="1.3s">WON</h6>
                                            <h1 data-animation="fadeInUp" data-delay="1.5s">
                                                <span class="shape-text">Global Olympiads</span><span></span> <br> for your child
                                               
                                            </h1>
                                            <p data-animation="fadeInUp" data-delay="1.7s">Explore global Olympiads, apply with ease, and access complete preparation and travel support.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="hero-items">
                            <div class="plane-shape">
                                <img src="{% static 'img/hero/new/plane-2.png' %}" alt="img">
                            </div>
                            <div class="plane-shape-2">
                                <img src="{% static 'img/hero/new/plane-3.png' %}" alt="img">
                            </div>
                            <div class="hero-bg bg-cover" style="background-image: url('{% static 'img/index/tutor1.jpg' %}');"></div>
                            <div class="container">
                                <div class="row g-4">
                                    <div class="col-lg-12">
                                        <div class="hero-content">
                                            <h6 data-animation="fadeInUp" data-delay="1.3s">WON</h6>
                                            <h1 data-animation="fadeInUp" data-delay="1.5s">
                                                <span class="shape-text">Olympiad Preparation</span><span>Tutors</span> <br> 
                                               
                                            </h1>
                                            <p data-animation="fadeInUp" data-delay="1.7s">Explore global Olympiads, apply with ease, and access complete preparation and travel support.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="booking-list-area-1">
                    <div class="booking-list">
                        <div class="icon">
                            <img src="{% static 'img/hero/location.png' %}" alt="img">
                        </div>
                        <div class="content">
                            <h5>Subject</h5>
                            <div class="form-clt">
                                <div class="form">
                                    <select class="single-select w-100">
                                        <option>Select subject</option>
                                        <option>Mathematics</option>
                                        <option>Physics</option>
                                        <option>Chemistry</option>
                                        <option>Biology</option>
                                        <option>Informatics</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="booking-list">
                        <div class="icon">
                            <img src="{% static 'img/hero/location.png' %}" alt="img">
                        </div>
                        <div class="content">
                            <h5>Region</h5>
                            <div class="form-clt">
                                <div class="form">
                                    <select class="single-select w-100">
                                        <option>Select region</option>
                                        <option>Global</option>
                                        <option>Africa</option>
                                        <option>Europe</option>
                                        <option>Asia</option>
                                        <option>Americas</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="booking-list">
                        <div class="icon">
                            <img src="{% static 'img/hero/location.png' %}" alt="img">
                        </div>
                        <div class="content">
                            <h5>Competition Date</h5>
                            <div class="form-clt">
                                <div id="datepicker" class="input-group date" data-date-format="dd-mm-yyyy">
                                    <input class="form-control" type="text" placeholder="Select date" readonly="">
                                    <span class="input-group-addon"><i class="far fa-calendar"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="booking-list">
                        <div class="icon">
                            <img src="{% static 'img/hero/location.png' %}" alt="img">
                        </div>
                        <div class="content">
                            <h5>Age Group</h5>
                            <div class="form-clt">
                                <div class="form">
                                    <select class="single-select w-100">
                                        <option>Select age group</option>
                                        <option>4-9</option>
                                        <option>10-13</option>
                                        <option>14-16</option>
                                        <option>17-20</option>
                                        <option>21-30</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="theme-btn">
                        <span>Search  <i class="far fa-search"></i></span>
                    </button>
                </div>
            </div>
        </section>


        <!--tour Package Section Start -->
        <section class="tour-package-section fix s section-padding">
            <div class="container">
                <div class="section-title text-center">
                    <span class="wow fadeInUp">Subscriptions</span>
                    <h2 class="wow fadeInUp" data-wow-delay=".3s">
                        Subscription Packages
                    </h2>
                    <p class="mt-3 wow fadeInUp" data-wow-delay=".5s">
                        Choose from our flexible subscription packages designed to fit different needs. <br>
                        Enjoy exclusive benefits, priority access, and exceptional value when you subscribe with us.
                    </p>
                </div>
                <div class="row">
                    <div class="col-xl-4 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".3s">
                        <div class="tour-main-item mt-30">
                            <div class="tour-box-items-3 bg-cover" style="background-image: url({% static 'img/index/parents.jpg' %});">
                                <div class="tour-content">
                                    <h3>
                                        Parents  
                                    </h3>
                                    <p class="text-white mb-4 font-weight-bold">
                                        Your Child is <br>
                                        A global Champion
                                    </p>
                                    <a href="tour-details.html" class="theme-btn">
                                        <span>Get Started</span> <i class="far fa-long-arrow-right"></i>
                                    </a>
                                </div>
                                <!-- <div class="percent-image">
                                    <img src="{% static 'img/tour/circle.png' %}" alt="img">
                                </div> -->
                            </div>
                            <div class="shape">
                                <img src="{% static 'img/tour/shape1.png' %}" alt="img">
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".5s">
                        <div class="tour-main-item mt-30">
                            <div class="tour-box-items-3 style-2 bg-cover" style="background-image: url({% static 'img/index/school2.jpg' %});">
                                <div class="tour-content">
                                    <h3>
                                        Schools
                                    </h3>
                                    <p class="text-white mb-4 font-weight-bold">
                                        Showcase your school <br> to be global leaders
                                    </p>
                                    <a href="tour-details.html" class="theme-btn">
                                        <span>Book Now</span> <i class="far fa-long-arrow-right"></i>
                                    </a>
                                </div>
                                <div class="percent-image">
                                    <img src="{% static 'img/tour/circle2.png' %}" alt="img">
                                </div>
                            </div>
                            <div class="shape">
                                <img src="{% static 'img/tour/shape2.png' %}" alt="img">
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay=".7s">
                        <div class="tour-main-item mt-30">
                            <div class="tour-box-items-3 style-3 bg-cover" style="background-image: url({% static 'img/index/study4.jpg' %});">
                                <div class="tour-content">
                                    <h3>
                                        Students
                                    </h3>
                                    <p class="text-white mb-4 font-weight-bold">
                                        Access resources and <br> Excell Abroad
                                    </p>
                                    <a href="tour-details.html" class="theme-btn">
                                        <span>Book Now</span> <i class="far fa-long-arrow-right"></i>
                                    </a>
                                </div>
                               
                            </div>
                            <div class="shape">
                                <img src="{% static 'img/tour/shape3.png' %}" alt="img">
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section> 


        <!-- Trending Section Start -->
        <section style="display: hidden;" class="trending-destinations section-padding fix">
            <div class="container">
                <div class="section-title-area lg-center">
                    <div class="section-title">
                        <span class="wow fadeInUp">Featured Competitions</span>
                        <h2 class="wow fadeInUp" data-wow-delay=".3s">Olympiads open for 2025</h2>
                    </div>
                    <a href="tour.html" class="theme-btn theme-btn-2 wow fadeInUp" data-wow-delay=".5s">
                        <span>View All Competitions</span> <i class="far fa-long-arrow-right"></i>
                    </a>
                </div>
                <!-- Featured Competitions Section -->
                <div class="row g-4">
                    <div class="col-xl-4 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay=".3s">
                        <div class="amazing-tour-items mt-0">
                            <div class="thumb">
                                <div class="post-box">
                                    <h4>$333</h4>
                                    <span>/ person</span>
                                </div>
                                <img src="{% static 'img/contests/contest1.webp' %}" alt="img" style="height: 250px; object-fit: cover; width: 100%;">
                                <div class="list-items">
                                    <h6>FEATURED</h6>
                                    <ul class="popup-icon">
                                        <li>
                                            <a href="https://www.youtube.com/watch?v=Cn4G2lZ_g2I" class="video-buttton video-popup">
                                                <i class="far fa-video"></i>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="{% static 'img/contests/contest1.webp' %}" class="img-popup">
                                                <i class="far fa-camera"></i>
                                            </a>
